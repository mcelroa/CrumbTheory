@CrumbTheoryAPI_HostAddress = https://localhost:7200

### Log in as admin (credentials come from user-secrets)
# @name login
POST {{CrumbTheoryAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "<your admin password>"
}

###
@token = {{login.response.body.$.token}}

### Products (public)
GET {{CrumbTheoryAPI_HostAddress}}/api/bakeryitems

###

@id=<a bakery item id>
GET {{CrumbTheoryAPI_HostAddress}}/api/bakeryitems/{{id}}

### Products (admin)
POST {{CrumbTheoryAPI_HostAddress}}/api/bakeryitems
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Lemon Drizzle Loaf",
  "price": 8.00,
  "description": "Zesty lemon sponge with a crunchy sugar glaze.",
  "imageUrl": "https://example.com/lemon-drizzle.jpg",
  "isAvailable": true
}

###

PUT {{CrumbTheoryAPI_HostAddress}}/api/bakeryitems/{{id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{id}}",
  "name": "Red Velvet Cupcake",
  "price": 4.75,
  "description": "Soft cocoa sponge topped with cream cheese frosting.",
  "isAvailable": false
}

###

DELETE {{CrumbTheoryAPI_HostAddress}}/api/bakeryitems/{{id}}
Authorization: Bearer {{token}}

### Place an order (public, pay on collection)
POST {{CrumbTheoryAPI_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerName": "Jane Doe",
  "email": "jane@example.com",
  "phone": "07700 900123",
  "pickupDate": "2030-01-15",
  "notes": "Birthday cake, please add a candle",
  "items": [
    { "bakeryItemId": "{{id}}", "quantity": 2 }
  ]
}

### Orders (admin)
GET {{CrumbTheoryAPI_HostAddress}}/api/orders?status=Pending
Authorization: Bearer {{token}}

###

@orderId=<an order id>
GET {{CrumbTheoryAPI_HostAddress}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}

###

PATCH {{CrumbTheoryAPI_HostAddress}}/api/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "Confirmed"
}

###
